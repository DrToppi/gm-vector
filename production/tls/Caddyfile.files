{
 admin off
 auto_https disable_redirects
}
https://{$GMA_HTTPS_HOST}:9443 {
 tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
 encode zstd gzip
 reverse_proxy api:8080 {
  header_up X-GMA-Client-IP {http.request.remote.host}
 }
}
http://{$GMA_HTTPS_HOST}:9080 {
 redir {$GMA_PUBLIC_ORIGIN}{uri} permanent
}
